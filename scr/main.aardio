        if (#cfg.apiKey == 0) {
            log("错误: 未配置 API Key");
            winform.lblStatus.text = "状态: 未配置 API Key";
            _setButtonsEnabled(true);
            return;
        }

        if (!..excel.init()) {
            log("错误: Excel 初始化失败");
            _setButtonsEnabled(true);
            return;
        }

        var outputWb = ..excel.openWorkbook(cfg.outputPath, false);
        if (!outputWb) {
            log("错误: 无法打开输出文件");
            ..excel.close();
            _setButtonsEnabled(true);
            return;
        }

        _runPhase3(cfg, outputWb);
        ..excel.close();

        var elapsed = (time.tick() - startTick) / 1000.0;
        var elapsedStr = _formatElapsed(elapsed);
        log("");
        log("=== 公司分析完成 ===");
        winform.lblStatus.text = "状态: 公司分析完成，共耗时 " + elapsedStr;
    }
    catch (e) {
        log("错误: " + tostring(e));
        try { ..excel.close(); } catch (e2) {}
