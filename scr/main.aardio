// ============================================================
// 窗口关闭
// ============================================================
winform.onClose = function() {
    try { ..excel.close(); } catch (e) {}
    winform.close();
}

// ============================================================
// 启动
// ============================================================
_logEdit = winform.logEdit;

var cfg = _loadAndDisplayConfig();
log("AardMiner 启动");
log("数据源: " + cfg.sourcePath);
log("结果文件: " + cfg.outputPath);
log("公司数量: " + #cfg.allCompanies);
log("API Key: " + (#cfg.apiKey > 0 ? "已配置" : "未配置"));
log("模型: " + cfg.model);
log("");
log("点击按钮开始执行");

winform.show();
win.loopMessage();
