// ============================================================
// 耗时格式化 (避免 string.format("%d", float) 触发 toInt 错误)
// ============================================================
var _formatElapsed = function(seconds) {
    var m = math.floor(seconds / 60);
    var s = math.floor(seconds % 60);
    var sStr = tostring(s);
    if (s < 10) sStr = "0" + sStr;
    return tostring(m) + "分" + sStr + "秒";
}

// ============================================================
// 目录/文件选择
// ============================================================
winform.btnBrowseDir.oncommand = function(id, event) {
    import fsys.dlg;
    var dir = fsys.dlg.openDir(winform.editDataDir.text, "选择数据源目录");
    if (#dir > 0) winform.editDataDir.text = dir;
};

winform.btnBrowseFile.oncommand = function(id, event) {
    import fsys.dlg;
    var filter = "Excel工作簿|*.xlsx|所有文件|*.*";
    var file = fsys.dlg.open(filter, "选择结果文件", winform.editOutputFile.text);
    if (#file > 0) winform.editOutputFile.text = file;
};

// ============================================================
// 从 UI 编辑框保存配置到 TOML 文件
// ============================================================
var _saveConfigFromUI = function() {
    var configPath = _configPath();
    var cfg = config.loadAll(configPath);

    // 从编辑框读取值并更新 cfg
    var srcPath = ..string.trim(winform.editDataDir.text);
    if (#srcPath > 0) cfg.sourcePath = srcPath;

    var outPath = ..string.trim(winform.editOutputFile.text);
    if (#outPath > 0) cfg.outputPath = outPath;

    var m = tonumber(..string.trim(winform.editMonth.text));
    if (m && m >= 1 && m <= 12) cfg.targetMonth = m;

    var y = tonumber(..string.trim(winform.editYear.text));
    if (y && y >= 2000 && y <= 2100) cfg.targetYear = y;

    var model = ..string.trim(winform.editModel.text);
    if (#model > 0) cfg.model = model;

    config.saveProjectConfig(cfg, configPath);
    log("配置已保存至 " + configPath);

    // 同时将月份/年份写入结果文件的"填写页"sheet
    try {
        var excelPath = ..string.trim(winform.editOutputFile.text);
        if (#excelPath > 0 && ..io.exist(excelPath)) {
            if (..excel.init()) {
                var wb = ..excel.openWorkbook(excelPath, false);
                if (wb && ..excel.sheetExists(wb, "填写页")) {
                    var ws = ..excel.getSheet(wb, "填写页");
                    if (cfg.targetMonth >= 1 && cfg.targetMonth <= 12) {
                        ..excel.writeCell(ws, 2, 1, cfg.targetMonth);
                    }
                    if (cfg.targetYear >= 2000 && cfg.targetYear <= 2100) {
                        ..excel.writeCell(ws, 4, 1, cfg.targetYear);
                    }
                    ..excel.saveWorkbook(wb);
                    log("已将月份/年份写入结果文件填写页");
                }
                ..excel.closeWorkbook(wb);
                ..excel.close();
            }
        }
    } catch (e) {
        // Excel 写入失败不影响 TOML 保存
    }
};

// ============================================================
// 按钮状态管理
// ============================================================
var _setButtonsEnabled = function(enabled) {
    winform.btnSummary.disabled = !enabled;
    winform.btnSector.disabled = !enabled;
    winform.btnCompany.disabled = !enabled;
}

// ============================================================
// 配置加载与显示
// ============================================================
var _loadAndDisplayConfig = function() {
    var cfg = config.loadAll(_configPath());

    // 填充可编辑配置项（路径中的双反斜杠转为单反斜杠显示）
    winform.editDataDir.text = ..string.replace(cfg.sourcePath, "\\\\", "\\");
    winform.editOutputFile.text = ..string.replace(cfg.outputPath, "\\\\", "\\");
    winform.editMonth.text = tostring(cfg.targetMonth);
    winform.editYear.text = tostring(cfg.targetYear);
    winform.editModel.text = cfg.model;
    winform.lblApiKey.text = "API Key: " + (#cfg.apiKey > 0 ? "已配置" : "未配置");

    return cfg;
}

// ============================================================
// 阶段1: 数据汇总
// ============================================================
var _runPhase1 = function(cfg, outputWb) {
    log("=== 阶段1: 数据汇总 ===");

    // 自动检测月份/年份
    if (cfg.targetMonth == 0 || cfg.targetYear == 0) {
        log("  正在从输出文件自动检测月份/年份...");
        if (..excel.sheetExists(outputWb, "填写页")) {
            var wsConfig = ..excel.getSheet(outputWb, "填写页");
            if (cfg.targetMonth == 0) {
                cfg.targetMonth = ..common.GetTargetMonth(wsConfig);
                log("  检测到报告月份: " + cfg.targetMonth + "月");
            }
            if (cfg.targetYear == 0) {
                cfg.targetYear = tonumber(..common.GetYearFromConfig(wsConfig));
                if (cfg.targetYear > 0) {
                    log("  检测到报告年份: " + cfg.targetYear);
                }
            }
            cfg.progressPercent = ..common.GetProgressFromConfig(wsConfig, cfg.targetMonth);
            if (cfg.progressPercent > 0) {
                log("  检测到序时进度: " + string.format("%.2f", cfg.progressPercent) + "%");
            }
            // 更新 UI 配置项（自动检测后回填）
            winform.editMonth.text = tostring(cfg.targetMonth);
            winform.editYear.text = tostring(cfg.targetYear);
        }
    }

    if (cfg.targetMonth < 1 || cfg.targetMonth > 12) {
        log("错误: 无法确定报告月份，数据汇总终止");
        return 0;
    }

    var ok = 0;

    // 经营报表复制 (9家)
    try {
        ok = ..report_copy.run(cfg, outputWb);
    } catch (e) {
        log("经营报表复制执行异常: " + tostring(e));
    }
    log("");

    // 保险汇总 (2家) - 每个子步骤独立容错
    try {
        ok = ok + ..insurance.run(cfg, outputWb);
    } catch (e) {
        log("保险汇总执行异常: " + tostring(e));
    }
    log("");

    // 商写汇总 (2家)
    try {
        ok = ok + ..commercial.run(cfg, outputWb);
    } catch (e) {
        log("商写汇总执行异常: " + tostring(e));
    }
    log("");

    // 酒店汇总 (2家)
    try {
        ok = ok + ..hotel.run(cfg, outputWb);
    } catch (e) {
        log("酒店汇总执行异常: " + tostring(e));
    }
    log("");

    // 保存
    ..excel.saveWorkbook(outputWb);
    log("数据汇总已保存");
    return ok;
}

// ============================================================
// 阶段2: 板块AI分析
// ============================================================
var _runPhase2 = function(cfg, outputWb) {
    log("=== 阶段2: 板块AI分析 ===");

    if (#cfg.apiKey == 0) {
        log("错误: 未配置 API Key，跳过板块分析");
        return 0;
    }

    var ok = ..sector_analysis.runAll(cfg, outputWb);
    ..excel.saveWorkbook(outputWb);
    log("板块分析已保存");
    return ok;
}

// ============================================================
// 阶段3: 公司AI分析
// ============================================================
var _runPhase3 = function(cfg, outputWb) {
    log("=== 阶段3: 公司核心指标分析 ===");

    if (#cfg.apiKey == 0) {
        log("错误: 未配置 API Key，跳过公司分析");
        return 0;
    }

    var ok = ..company_analysis.runAll(cfg, outputWb);
    ..excel.saveWorkbook(outputWb);
    log("公司分析已保存");
    return ok;
}

// ============================================================
// 按钮事件: 数据汇总
// ============================================================
winform.btnSummary.oncommand = function(id, event) {
    _setButtonsEnabled(false);

    var startTick = time.tick();

    try {
        _saveConfigFromUI();
        var cfg = _loadAndDisplayConfig();

        if (!..excel.init()) {
            log("错误: Excel 初始化失败");
            winform.lblStatus.text = "状态: Excel 初始化失败";
            _setButtonsEnabled(true);
            return;
        }

        var outputWb = ..excel.openWorkbook(cfg.outputPath, false);
        if (!outputWb) {
            log("错误: 无法打开输出文件");
            ..excel.close();
            winform.lblStatus.text = "状态: 无法打开输出文件";
            _setButtonsEnabled(true);
            return;
        }

        _runPhase1(cfg, outputWb);
        ..excel.close();

        var elapsed = (time.tick() - startTick) / 1000.0;
        var elapsedStr = _formatElapsed(elapsed);
        log("");
        log("=== 数据汇总完成 ===");
        winform.lblStatus.text = "状态: 数据汇总完成，共耗时 " + elapsedStr;
    }
    catch (e) {
        log("错误: " + tostring(e));
        try { ..excel.close(); } catch (e2) {}
        winform.lblStatus.text = "状态: 执行出错";
    }

    _setButtonsEnabled(true);
}

// ============================================================
// 按钮事件: 业态分析
// ============================================================
winform.btnSector.oncommand = function(id, event) {
    _setButtonsEnabled(false);

    var startTick = time.tick();

    try {
        _saveConfigFromUI();
        var cfg = _loadAndDisplayConfig();

        if (#cfg.apiKey == 0) {
            log("错误: 未配置 API Key");
            winform.lblStatus.text = "状态: 未配置 API Key";
            _setButtonsEnabled(true);
            return;
        }

        if (!..excel.init()) {
            log("错误: Excel 初始化失败");
            _setButtonsEnabled(true);
            return;
        }

        var outputWb = ..excel.openWorkbook(cfg.outputPath, false);
        if (!outputWb) {
            log("错误: 无法打开输出文件");
            ..excel.close();
            _setButtonsEnabled(true);
            return;
        }

        _runPhase2(cfg, outputWb);
        ..excel.close();

        var elapsed = (time.tick() - startTick) / 1000.0;
        var elapsedStr = _formatElapsed(elapsed);
        log("");
        log("=== 业态分析完成 ===");
        winform.lblStatus.text = "状态: 业态分析完成，共耗时 " + elapsedStr;
    }
    catch (e) {
        log("错误: " + tostring(e));
        try { ..excel.close(); } catch (e2) {}
        winform.lblStatus.text = "状态: 执行出错";
    }

    _setButtonsEnabled(true);
}

// ============================================================
// 按钮事件: 公司分析
// ============================================================
