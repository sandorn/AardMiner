// main.aardio -- AardMiner 入口
// 功能: 加载配置, 初始化Excel COM, 编排三阶段执行流程, 提供桌面UI
// 三个阶段:
//   1. 数据汇总: report_copy → insurance → commercial → hotel
//   2. 板块AI分析: 商写 → 保险 → 酒店
//   3. 公司AI分析: 9家逐公司

import win.ui;
import string;
import io;
import fsys;
import models;
import config;
import excel;
import common;
import report_copy;
import insurance;
import commercial;
import hotel;
import deepseek_api;
import sector_analysis;
import company_analysis;

// ============================================================
// 全局日志
// ============================================================
var _logLines = {};
var _logEdit = null;

var log = function(msg) {
    var tm = time();
    var ts = string.format("%02d:%02d:%02d", tm.hour, tm.minute, tm.second);
    var line = ts + "  " + msg;
    table.push(_logLines, line);

    if (_logEdit) {
        _logEdit.text = string.join(_logLines, '\r\n');
        // 自动滚动到底部
        var len = #_logEdit.text;
        _logEdit.setsel(len, len);
        _logEdit.scrollCaret();
    }
}

// 将全局 print 重定向到 UI 日志，使 lib/*.aardio 中的 ..print() 输出到界面
..print = function(msg) {
    log(tostring(msg));
}

// ============================================================
// 配置文件路径（多级回退，确保在各种运行环境下都能找到 project.toml）
// ============================================================
var _configPath = function() {
    // 方法1: 基于应用程序根目录（IDE 中运行 = 项目目录，发布后 = EXE 目录）
    var path = io.fullpath("/project.toml");
    if (io.exist(path)) return path;

    // 方法2: 基于当前工作目录
    path = io.fullpath("project.toml");
    if (io.exist(path)) return path;

    // 方法3: 上级目录（兼容旧位置 ../project.toml）
    path = io.fullpath("../project.toml");
    if (io.exist(path)) return path;

    // 都不存在则返回方法1的路径，让 config.loadAll 输出友好警告
    return io.fullpath("/project.toml");
}

